generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                         String                     @id @default(uuid())
  email                      String                     @unique
  password_hash              String?
  role                       Role                       @default(USER)
  created_at                 DateTime                   @default(now())
  steam_id                   Int?                       @unique
  settings                   Json?
  game_times                 GameTime[]                 @relation("UserGameTimes")
  movie_reviews              MovieReview[]              @relation("UserMovieReviews")
  oauth                      OAuth[]                    @relation("UserOauth")
  wishlists                  Wishlist?                  @relation("UserWishlists")
  trips                      Trip[]                     @relation("UserTrips")
  templates                  Template[]                 @relation("UserTemplates")
  gear_items                 GearItem[]                 @relation("UserGearItems")
  travel_wishlist            TravelWishlistItem[]       @relation("UserTravelWishlist")
  loadouts                   Loadout[]                  @relation("UserLoadouts")
  item_reviews               ItemReview[]               @relation("UserItemReviews")
  trip_reviews               TripReview[]               @relation("UserTripReviews")
  notification_subscriptions NotificationSubscription[] @relation("UserNotificationSubscriptions")
  email_verifications        EmailVerification[]        @relation("UserEmailVerifications")
}

model Game {
  id         Int        @id @default(autoincrement())
  appid      Int        @unique
  name       String
  game_times GameTime[] @relation("GameGameTimes")
}

model GameTime {
  id         Int      @id @default(autoincrement())
  user       String
  game       Int
  play_time  Int
  updated_at DateTime @default(now())
  game_rel   Game     @relation("GameGameTimes", fields: [game], references: [id])
  user_rel   User     @relation("UserGameTimes", fields: [user], references: [id])

  @@unique([user, game], name: "user_game")
  @@index([game])
}

model Movie {
  id            Int           @id @default(autoincrement())
  tmdb_id       Int           @unique
  name          String
  movie_reviews MovieReview[] @relation("MovieMovieReviews")
}

model MovieReview {
  id        Int    @id @default(autoincrement())
  user      String
  movie     Int
  rating    Int
  movie_rel Movie  @relation("MovieMovieReviews", fields: [movie], references: [id])
  user_rel  User   @relation("UserMovieReviews", fields: [user], references: [id])

  @@unique([user, movie], name: "user_movie")
  @@index([movie])
}

model OAuth {
  id               Int    @id @default(autoincrement())
  provider         String
  provider_user_id String
  access_token     String
  user             String
  user_rel         User   @relation("UserOauth", fields: [user], references: [id])

  @@unique([user, provider], name: "user_provider")
}

model Band {
  id                         Int                        @id @default(autoincrement())
  name                       String                     @unique
  ticketmaster_id            String?                    @unique
  created_at                 DateTime?
  MBID                       String?                    @unique
  songkick_url               String?
  bandsintown_url            String?
  setlist                    Json?
  setlist_updated_at         DateTime?
  concerts                   ConcertBandReference[]     @relation("BandConcerts")
  wishlists                  WishlistBandReference[]    @relation("BandWishlists")
  notification_subscriptions NotificationSubscription[] @relation("BandNotificationSubscriptions")
}

model Concert {
  id                Int                    @id @default(autoincrement())
  country           String
  venue             String
  created_at        DateTime
  on_sale           Boolean
  city              String
  concert_date      DateTime?
  event_id          String?                @unique
  latitude          String?                @db.VarChar
  longitude         String?                @db.VarChar
  metadata          String?
  name              String?
  ticket_sale_start DateTime?              @db.Timestamp(6)
  url               String?
  festival          Boolean?               @default(false)
  source            String?
  weather           Json?
  price_min         Float?
  price_max         Float?
  price_currency    String?
  sold_out          Boolean?               @default(false)
  reachable         String?
  city_id           Int?
  city_rel          City?                  @relation(fields: [city_id], references: [id])
  bands             ConcertBandReference[] @relation("ConcertBands")
  attendances       ConcertAttendance[]    @relation("ConcertAttendances")

  @@index([city_id])
  @@index([concert_date, latitude, longitude])
  @@index([concert_date])
}

model City {
  id                         Int                        @id @default(autoincrement())
  name                       String
  country                    String
  latitude                   Float?
  longitude                  Float?
  reachable                  String?
  airport_iata               String?
  weather_monthly            Json?
  weather_updated_at         DateTime?
  created_at                 DateTime                   @default(now())
  concerts                   Concert[]
  notification_subscriptions NotificationSubscription[] @relation("CityNotificationSubscriptions")

  @@unique([name, country])
}

model Country {
  id   Int    @id @default(autoincrement())
  name String
  iso  String
}

model ConcertBandReference {
  id          Int     @id @default(autoincrement())
  concert     Int
  band        Int
  setlist     Json?
  band_rel    Band    @relation("BandConcerts", fields: [band], references: [id])
  concert_rel Concert @relation("ConcertBands", fields: [concert], references: [id])

  @@unique([concert, band], name: "concert_band")
  @@index([band])
}

model Wishlist {
  id                 Int                     @id @default(autoincrement())
  name               String
  user_id            String                  @unique
  discord_webhook    String?
  concert_scores     String?
  city_rankings      String?
  scores_computed_at DateTime?
  last_active_at     DateTime?
  user_rel           User                    @relation("UserWishlists", fields: [user_id], references: [id])
  bands              WishlistBandReference[] @relation("WishlistBands")
  activity_logs      ActivityLog[]           @relation("WishlistActivityLogs")
  attendance         ConcertAttendance[]     @relation("WishlistAttendance")
}

model ActivityLog {
  id           Int      @id @default(autoincrement())
  wishlist_id  Int
  type         String // 'BAND_ADDED' | 'NEW_CONCERTS'
  data         String // JSON
  created_at   DateTime @default(now())
  wishlist_rel Wishlist @relation("WishlistActivityLogs", fields: [wishlist_id], references: [id])

  @@index([wishlist_id])
}

model WishlistBandReference {
  id           Int      @id @default(autoincrement())
  band_id      Int
  wishlist_id  Int
  tier         BandTier @default(FOLLOW)
  band_rel     Band     @relation("BandWishlists", fields: [band_id], references: [id])
  wishlist_rel Wishlist @relation("WishlistBands", fields: [wishlist_id], references: [id])

  @@unique([band_id, wishlist_id], name: "band_wishlist")
  @@index([wishlist_id])
}

model ConcertAttendance {
  id           Int      @id @default(autoincrement())
  wishlist_id  Int
  concert_id   Int
  created_at   DateTime @default(now())
  wishlist_rel Wishlist @relation("WishlistAttendance", fields: [wishlist_id], references: [id])
  concert_rel  Concert  @relation("ConcertAttendances", fields: [concert_id], references: [id])

  @@unique([wishlist_id, concert_id])
  @@index([concert_id])
}

// A user's watch for new concerts: by band, by city, or a band-in-a-specific-city combo.
// band_id null == any band. city_id null == any city. At least one is always set (enforced in the route).
model NotificationSubscription {
  id         Int      @id @default(autoincrement())
  user_id    String
  band_id    Int?
  city_id    Int?
  created_at DateTime @default(now())
  user_rel   User     @relation("UserNotificationSubscriptions", fields: [user_id], references: [id], onDelete: Cascade)
  band_rel   Band?    @relation("BandNotificationSubscriptions", fields: [band_id], references: [id], onDelete: Cascade)
  city_rel   City?    @relation("CityNotificationSubscriptions", fields: [city_id], references: [id], onDelete: Cascade)

  @@index([band_id])
  @@index([city_id])
}

// Single-row cursor for the notification digest cron: tracks the last time it ran
// so each pass only scans concerts created since then.
model NotificationDigestRun {
  id          Int      @id @default(autoincrement())
  last_run_at DateTime @default(now())
}

// Email verification codes for email change requests
model EmailVerification {
  id         Int      @id @default(autoincrement())
  user_id    String
  new_email  String
  code       String   @unique
  expires_at DateTime
  created_at DateTime @default(now())
  user_rel   User     @relation("UserEmailVerifications", fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

enum Role {
  USER
  ADMIN
  SYSTEM
}

enum BandTier {
  LOVE
  LIKE
  FOLLOW
}

// ── TRAVEL BAG ────────────────────────────────────────────────────────────────

model Trip {
  id                   Int               @id @default(autoincrement())
  user_id              String
  name                 String            @db.VarChar(200)
  destination          String?           @db.VarChar(200)
  start_date           DateTime?         @db.Date
  end_date             DateTime?         @db.Date
  notes                String?           @db.Text
  weight_budget        Int?
  money_budget         Decimal?          @db.Decimal(10, 2)
  currency             String            @default("SEK") @db.VarChar(3)
  budget_flights       Decimal?          @db.Decimal(10, 2)
  budget_hotel         Decimal?          @db.Decimal(10, 2)
  budget_entertainment Decimal?          @db.Decimal(10, 2)
  budget_food          Decimal?          @db.Decimal(10, 2)
  weather_data         Json?
  weather_updated_at   DateTime?
  exchange_rates       Json?
  tags                 String[]
  // When you land and when you fly out, as minutes since midnight on the first
  // and last day. Without them the planner offers a 09:00 museum on a day you
  // arrive at 14:00, which is worse than no plan for that day at all.
  arrival_time         Int?
  departure_time       Int?
  // Where those days begin and end. Optional: left null the hotel is used, which
  // is right for a train you catch from town and wrong for an airport an hour
  // out. Not a relation — a foreign key back to TripPlace would have to be
  // cleared by hand every time a place is deleted, and a stale id here is
  // already handled by the planner refusing to plan against a place it cannot
  // find.
  arrival_place_id     Int?
  departure_place_id   Int?
  // How long it takes to get between a terminal and the city, by whatever means
  // people actually use. Nobody walks out of an airport, and routing one the
  // same way as a museum produced a five-and-a-half hour walk from CDG.
  transfer_minutes     Int?
  // The last day plan the solver returned, stored whole. Not normalised into
  // rows: it is one immutable answer to one question, always read in full and
  // always replaced in full, and the shape belongs to route-planner rather than
  // to this schema. Null means "never planned", which the UI shows differently
  // from an empty plan.
  plan_data            Json?
  plan_updated_at      DateTime?
  created_at           DateTime          @default(now())
  updated_at           DateTime          @updatedAt
  user_rel             User              @relation("UserTrips", fields: [user_id], references: [id])
  items                TripItem[]
  estimates            ExpenseEstimate[]
  reviews              ItemReview[]      @relation("TripItemReviews")
  trip_review          TripReview?
  todos                TripTodo[]
  places               TripPlace[]

  @@index([user_id])
}

// Somewhere you intend to go on a trip — a museum, a restaurant, the hotel.
// Distinct from TripItem, which is something you pack.
//
// lat/lon are written once when the place is saved and then left alone, because
// a museum does not move. They are nullable on purpose: a place nothing could
// geocode is still worth keeping, flagged, and the solver reports it as dropped
// rather than refusing to plan the trip.
model TripPlace {
  id               Int       @id @default(autoincrement())
  trip_id          Int
  name             String    @db.VarChar(200)
  kind             PlaceKind @default(SIGHT)
  lat              Float?
  lon              Float?
  address          String?   @db.VarChar(500)
  url              String?   @db.VarChar(1000)
  // Minutes to spend there. Null lets the solver apply its own default rather
  // than making every place a form to fill in before the trip can be planned.
  duration         Int?
  priority         Int       @default(3)
  outdoor          Boolean   @default(false)
  // Per weekday, [open, close] minute pairs: { "tue": [[570, 1080]] }. Absent
  // means always open; an explicit [] means closed that day. A weekday simply
  // missing from the object means unknown, and unknown is treated as open —
  // guessing "closed" silently deletes places from a trip.
  hours            Json?
  pinned_day       DateTime? @db.Date
  // A ticket or a reservation, as minutes since midnight. These bound when you
  // turn up, not when you leave — both set to the same minute is a timed entry.
  // Usually paired with pinned_day: on their own they apply to whichever day
  // the place ends up on.
  arrive_after     Int?
  arrive_by        Int?
  // Demotes `hours` to reference. Opening times are about getting inside, and
  // seeing a building lit up, a night tour or a concert in a venue that shuts
  // at six have nothing to do with that. The hours stay stored — they are still
  // worth knowing — they just stop constraining the plan.
  ignore_hours     Boolean   @default(false)
  // A paragraph about the place from Wikipedia, with the article it came from.
  // Cached rather than fetched on view: it does not change, and Wikipedia asks
  // for politeness. `blurb_checked_at` records that we *looked* — most places
  // have no article and never will, and without it every load re-asks about the
  // same neighbourhood restaurant forever.
  blurb            String?   @db.Text
  blurb_url        String?   @db.VarChar(500)
  blurb_checked_at DateTime?
  note             String?   @db.Text
  sort_order       Int       @default(0)
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  trip_rel         Trip      @relation(fields: [trip_id], references: [id], onDelete: Cascade)

  @@index([trip_id])
}

// Things to do before a trip that aren't gear — book the taxi, print the
// tickets, refill the water filter. Owned through the trip, so deleting a trip
// takes its list with it.
model TripTodo {
  id         Int      @id @default(autoincrement())
  trip_id    Int
  text       String   @db.VarChar(300)
  done       Boolean  @default(false)
  sort_order Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  trip_rel   Trip     @relation(fields: [trip_id], references: [id], onDelete: Cascade)

  @@index([trip_id])
}

model TripItem {
  id            Int           @id @default(autoincrement())
  trip_id       Int
  name          String        @db.VarChar(200)
  category      String?       @db.VarChar(100)
  status        PackingStatus @default(NEED_TO_BUY)
  note          String?       @db.Text
  url           String?       @db.VarChar(500)
  sort_order    Int           @default(0)
  gear_item_id  Int?
  worn          Boolean       @default(false)
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt
  bag_id        Int?
  trip_rel      Trip          @relation(fields: [trip_id], references: [id], onDelete: Cascade)
  gear_item_rel GearItem?     @relation("GearItemTripItems", fields: [gear_item_id], references: [id], onDelete: SetNull)
  bag_rel       GearItem?     @relation("TripItemBag", fields: [bag_id], references: [id], onDelete: SetNull)
  reviews       ItemReview[]  @relation("TripItemReview")

  @@index([bag_id])
  @@index([gear_item_id])
  @@index([trip_id])
}

model ExpenseEstimate {
  id         Int       @id @default(autoincrement())
  trip_id    Int
  category   String    @db.VarChar(100)
  amount     Decimal   @db.Decimal(10, 2)
  currency   String    @default("SEK") @db.VarChar(3)
  date       DateTime? @db.Date
  end_date   DateTime? @db.Date
  note       String?   @db.Text
  sort_order Int       @default(0)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  trip_rel   Trip      @relation(fields: [trip_id], references: [id], onDelete: Cascade)

  @@index([trip_id])
}

model Template {
  id          Int            @id @default(autoincrement())
  user_id     String
  name        String         @db.VarChar(200)
  description String?        @db.Text
  created_at  DateTime       @default(now())
  updated_at  DateTime       @updatedAt
  user_rel    User           @relation("UserTemplates", fields: [user_id], references: [id])
  items       TemplateItem[]

  @@index([user_id])
}

model TemplateItem {
  id           Int      @id @default(autoincrement())
  template_id  Int
  name         String   @db.VarChar(200)
  category     String?  @db.VarChar(100)
  note         String?  @db.Text
  url          String?  @db.VarChar(500)
  sort_order   Int      @default(0)
  created_at   DateTime @default(now())
  template_rel Template @relation(fields: [template_id], references: [id], onDelete: Cascade)

  @@index([template_id])
}

model GearItem {
  id               Int            @id @default(autoincrement())
  user_id          String
  name             String         @db.VarChar(200)
  model            String?        @db.VarChar(200)
  brand            String?        @db.VarChar(100)
  category         String?        @db.VarChar(100)
  dimensions       Json?
  tags             String[]
  sort_order       Int            @default(0)
  worn             Boolean        @default(false)
  notes            String?        @db.Text
  url              String?        @db.VarChar(500)
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt
  review_status    ReviewStatus?
  review_streak    Int            @default(0)
  review_count     Int            @default(0)
  last_review_at   DateTime?
  essential        Boolean        @default(false)
  retired          Boolean        @default(false)
  replaced_by_id   Int?
  photo            String?        @db.Text
  retail_price     Decimal?       @db.Decimal(10, 2)
  bought_for       Decimal?       @db.Decimal(10, 2)
  currency         String         @default("SEK") @db.VarChar(3)
  fill_level       Int?
  price_irrelevant Boolean        @default(false)
  user_rel         User           @relation("UserGearItems", fields: [user_id], references: [id])
  trip_items       TripItem[]     @relation("GearItemTripItems")
  trip_bag_items   TripItem[]     @relation("TripItemBag")
  loadout_entries  LoadoutEntry[] @relation("GearItemLoadoutEntries")
  bag_entries      LoadoutEntry[] @relation("LoadoutEntryBag")
  reviews          ItemReview[]   @relation("GearItemReviews")
  replaced_by_rel  GearItem?      @relation("GearUpgrade", fields: [replaced_by_id], references: [id], onDelete: SetNull)
  replaces         GearItem[]     @relation("GearUpgrade")

  @@index([replaced_by_id])
  @@index([user_id])
}

model ItemReview {
  id            Int             @id @default(autoincrement())
  user_id       String
  trip_id       Int
  trip_item_id  Int?
  gear_item_id  Int?
  item_name     String          @db.VarChar(200)
  usage         ReviewUsage?
  rating        Int?
  verdict       ReviewVerdict
  quantity      ReviewQuantity?
  note          String?         @db.Text
  created_at    DateTime        @default(now())
  updated_at    DateTime        @updatedAt
  user_rel      User            @relation("UserItemReviews", fields: [user_id], references: [id])
  trip_rel      Trip            @relation("TripItemReviews", fields: [trip_id], references: [id], onDelete: Cascade)
  trip_item_rel TripItem?       @relation("TripItemReview", fields: [trip_item_id], references: [id], onDelete: SetNull)
  gear_item_rel GearItem?       @relation("GearItemReviews", fields: [gear_item_id], references: [id], onDelete: SetNull)

  @@unique([trip_id, trip_item_id])
  @@index([gear_item_id])
  @@index([trip_item_id])
  @@index([user_id])
}

model TripReview {
  id                    Int      @id @default(autoincrement())
  user_id               String
  trip_id               Int      @unique
  culture_rating        Int?
  culture_note          String?  @db.Text
  food_rating           Int?
  food_note             String?  @db.Text
  fun_rating            Int?
  fun_note              String?  @db.Text
  missing_gear_item_ids Int[]
  missing_note          String?  @db.Text
  comment               String?  @db.Text
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt
  user_rel              User     @relation("UserTripReviews", fields: [user_id], references: [id])
  trip_rel              Trip     @relation(fields: [trip_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model TravelWishlistItem {
  id         Int      @id @default(autoincrement())
  user_id    String
  name       String   @db.VarChar(200)
  brand      String?  @db.VarChar(100)
  model      String?  @db.VarChar(200)
  category   String?  @db.VarChar(100)
  url        String?  @db.VarChar(500)
  notes      String?  @db.Text
  price      Float?
  currency   String   @default("SEK") @db.VarChar(3)
  dimensions Json?
  keywords   String[]
  bought     Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user_rel   User     @relation("UserTravelWishlist", fields: [user_id], references: [id])

  @@index([user_id])
}

model Loadout {
  id            Int            @id @default(autoincrement())
  user_id       String
  name          String         @db.VarChar(200)
  description   String?        @db.Text
  weight_budget Int?
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt
  user_rel      User           @relation("UserLoadouts", fields: [user_id], references: [id])
  entries       LoadoutEntry[]

  @@index([user_id])
}

model LoadoutEntry {
  id            Int       @id @default(autoincrement())
  loadout_id    Int
  gear_item_id  Int
  worn          Boolean   @default(false)
  bag_id        Int?
  created_at    DateTime  @default(now())
  loadout_rel   Loadout   @relation(fields: [loadout_id], references: [id], onDelete: Cascade)
  gear_item_rel GearItem  @relation("GearItemLoadoutEntries", fields: [gear_item_id], references: [id], onDelete: Cascade)
  bag_rel       GearItem? @relation("LoadoutEntryBag", fields: [bag_id], references: [id], onDelete: SetNull)

  @@unique([loadout_id, gear_item_id])
  @@index([bag_id])
  @@index([gear_item_id])
}

enum PackingStatus {
  NEED_TO_BUY
  BOUGHT
  PACKED
  NOT_PACKED
}

// What a place is *for*, which is the only thing the solver treats differently:
// a HOTEL anchors the start and end of a day, a FOOD place can fill a meal slot
// and nothing else, a SIGHT is an ordinary optional stop.
enum PlaceKind {
  SIGHT
  FOOD
  HOTEL
}

enum ReviewUsage {
  NEVER
  SOMETIMES
  OFTEN
}

enum ReviewVerdict {
  KEEP
  REPLACE
  DITCH
}

enum ReviewQuantity {
  TOO_FEW
  RIGHT
  TOO_MANY
}

enum ReviewStatus {
  LOCKED
  FLAGGED
}
