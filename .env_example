# Required
DATABASE_URL=
JWT_SECRET=
# The API's own public base URL, used in every link back to it (media,
# calendar feeds, OAuth redirects). Without it the media routes 500.
CALLBACK_URL=
# Where concert-map lives, for sending the browser back after an OAuth login.
CONCERT_MAP_URL=
PORT=4000

# Photo and video archive (docs/concert-media-runbook.md)
MEDIA_ROOT=
MEDIA_URL_SECRET=

# Python sync service (python-crohn). SCRAPER_TOKEN must match its copy.
PYTHON_SERVICE_URL=
PYTHON_SERVICE_FALLBACK_URL=
SCRAPER_TOKEN=

# Redis cache, optional. Either a connection string, or the Upstash REST
# pair to derive one from.
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email: verification codes and the notification digest
RESEND_API_KEY=
NOTIFICATIONS_FROM_EMAIL=

# Music data
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Tidal, an alternative place for setlist playlists. From developer.tidal.com,
# with <CALLBACK_URL>/oauth/tidal/callback added as a redirect URI.
TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=
SETLIST_API_KEY=
LASTFM_API_KEY=
# User-Agent for MusicBrainz, which asks for a contact
APP_NAME=
APP_VERSION=
APP_CONTACT=

# Travel
ROUTE_PLANNER_URL=
ROUTE_PLANNER_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=

# Cron overrides, optional. The defaults are in utils/cron.js.
NOTIFICATION_DIGEST_CRON=
SPOTIFY_BACKFILL_CRON=
SOURCE_URL_BACKFILL_CRON=
SETLIST_BACKFILL_CRON=
WEEKLY_RECAP_CRON=
